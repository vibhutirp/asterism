{
  "name": "Observatory",
  "version": "0.1",
  "status": "Design specification; not application code",
  "scope": "Read-only exploration of topics, memories and sources",
  "color": {
    "canvas": "#080D19",
    "panel": "#101827",
    "raised": "#182338",
    "hover": "#202E45",
    "source": "#0C1422",
    "quietBorder": "#2A3850",
    "controlBorder": "#657C9E",
    "primary": "#EDF2FA",
    "secondary": "#B6C2D5",
    "muted": "#95A5BE",
    "icon": "#DAE9FF",
    "link": "#8DC6FF",
    "focus": "#BEDCFF",
    "accent": "#B8A7FF",
    "onAccent": "#101321",
    "product": "#83B8FF",
    "personal": "#7DDECA",
    "saved": "#7DDECA",
    "processing": "#C8B6FF",
    "error": "#FFB4B4",
    "badgeText": "#C7D4E8",
    "badgeSurface": "#1D2940",
    "labelBacking": "#13203A"
  },
  "spacing": {
    "unit": 4,
    "iconGap": 8,
    "controlGap": 12,
    "componentPadding": 16,
    "panelPadding": 24,
    "sectionGap": 32,
    "majorGap": 48,
    "regionGap": 64,
    "scale": [
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64
    ]
  },
  "typography": {
    "family": "Inter",
    "fallback": "system-ui, -apple-system, Segoe UI, sans-serif",
    "weights": [
      400,
      500,
      600
    ],
    "roles": {
      "title": {
        "size": 28,
        "lineHeight": 36,
        "weight": 600
      },
      "section": {
        "size": 20,
        "lineHeight": 28,
        "weight": 600
      },
      "body": {
        "size": 16,
        "lineHeight": 24,
        "weight": 400
      },
      "topic": {
        "size": 16,
        "lineHeight": 24,
        "weight": 500
      },
      "control": {
        "size": 14,
        "lineHeight": 20,
        "weight": 500
      },
      "metadata": {
        "size": 14,
        "lineHeight": 20,
        "weight": 400
      },
      "badge": {
        "size": 14,
        "lineHeight": 20,
        "weight": 600
      }
    }
  },
  "shape": {
    "controlRadius": 8,
    "panelInsetRadius": 12,
    "badgeRadius": 4,
    "sourceRadius": 0,
    "dividerWidth": 1,
    "focusWidth": 2,
    "focusOffset": 3,
    "quoteRuleWidth": 2
  },
  "layout": {
    "referenceViewport": {
      "width": 1440,
      "height": 1024
    },
    "headerHeight": 64,
    "inspectorWidths": {
      "wide": 512,
      "compact": 400
    },
    "breakpoints": {
      "wide": 1280,
      "compact": 1024
    },
    "controlHeight": 44,
    "iconTarget": 44,
    "topicTarget": 44,
    "listRowMinHeight": 72,
    "iconSize": 20,
    "smallIconSize": 16,
    "iconStrokeWidth": 1.75,
    "topicSlot": {
      "width": 240,
      "height": 96
    },
    "labelMaxWidth": 176
  },
  "light": {
    "glyph": {
      "color": "icon",
      "layers": [
        {
          "blur": 4,
          "opacity": 0.22
        },
        {
          "blur": 10,
          "opacity": 0.12
        }
      ]
    },
    "hover": {
      "color": "accent",
      "layers": [
        {
          "blur": 8,
          "opacity": 0.22
        },
        {
          "blur": 20,
          "opacity": 0.14
        }
      ]
    },
    "topic": {
      "color": "category",
      "layers": [
        {
          "blur": 6,
          "opacity": 0.45
        },
        {
          "blur": 18,
          "opacity": 0.22
        }
      ]
    },
    "disabled": "none",
    "paragraph": "none"
  },
  "motion": {
    "hoverMs": 150,
    "disclosureMs": 150,
    "newDataHighlightMs": 600,
    "reducedMotionMs": 0,
    "easing": "ease-out",
    "looping": false,
    "animateBlur": false
  },
  "topic": {
    "diameterFormula": "min(20, 8 + 2 * log2(memoryCount + 1)) CSS px for memoryCount >= 1",
    "selectionRingDiameter": 44,
    "selectionRingWidth": 2,
    "selectedCoreSizeChange": 0,
    "maxStarRadiusWithGlow": 28,
    "positions": "Stable by topic identity; never recompute because a memory count changes",
    "zeroMemoryBehavior": "No map star; list may show explicit 0 memories"
  },
  "accessibility": {
    "normalTextContrastTarget": 4.5,
    "nonTextContrastTarget": 3,
    "productPointerTarget": 44,
    "visibleFocus": true,
    "bodyGlow": false,
    "opaqueBackingForMapLabels": "labelBacking",
    "requiredNativeZoomChecks": [
      100,
      200
    ]
  },
  "boundaries": {
    "webCapture": false,
    "webAsk": false,
    "knowledgeMutation": false,
    "graphEditing": false,
    "decorativeStarPoints": false,
    "relationshipLines": false
  }
}
